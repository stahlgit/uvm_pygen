# ------------------------------------------------------------------------------
# Generated by uvm_pygen
# Project:  {{ project_name }}
# DUT:      {{ dut_name }}
# Description: Waveform signal configuration for QuestaSim / ModelSim
# ------------------------------------------------------------------------------

proc basic { PATH } {
    add wave -noupdate -divider "Basic signals"
    add wave -noupdate -color yellow -label {{ clock_name }} $PATH/{{ clock_name }}
    add wave -noupdate -color yellow -label {{ reset_name }} $PATH/{{ reset_name }}
}

{% for iface in interfaces %}
proc {{ iface.name }}_inputs { PATH } {
    add wave -divider "{{ iface.name }} inputs"
{% for port in iface.input_ports %}
    add wave -noupdate {% if port.width != 1 %}-hex {% endif %}-label {{ port.name }} $PATH/{{ port.signal_name }}
{% endfor %}
}

proc {{ iface.name }}_outputs { PATH } {
    add wave -divider "{{ iface.name }} outputs"
{% for port in iface.output_ports %}
    add wave -noupdate {% if port.width != 1 %}-hex {% endif %}-label {{ port.name }} $PATH/{{ port.signal_name }}
{% endfor %}
}

{% endfor %}
proc customize_gui { TOP_MODULE } {
    view wave
    delete wave *
    puts $TOP_MODULE

    basic $TOP_MODULE
{% for iface in interfaces %}
    {{ iface.name }}_inputs  $TOP_MODULE/{{ iface.instance }}
    {{ iface.name }}_outputs $TOP_MODULE/{{ iface.instance }}
{% endfor %}

    TreeUpdate [SetDefaultTree]
    configure wave -namecolwidth 200
    configure wave -valuecolwidth 100
    configure wave -justifyvalue left
    configure wave -signalnamewidth 0
    configure wave -gridoffset 0
    configure wave -gridperiod {10 ns}
    configure wave -griddelta 50
    configure wave -timeline 0
    configure wave -timelineunits ns
    update
    view structure
    view signals
}
