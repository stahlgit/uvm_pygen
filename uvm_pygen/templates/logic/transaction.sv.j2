//------------------------------------------------------------------------------
// Class: {{ trans.class_name }}
// Description: Generated Transaction Object
//------------------------------------------------------------------------------

class {{ trans.class_name }} extends {{ trans.base_class }};

    // Variables
    // Inputs
    {% for var in trans.variables %}
    {% if var.direction == "input" %}
    {% if var.is_rand %}    rand {% endif %}{{ var.sv_type }} {{ var.name }};
    {% endif %}
    {% endfor %}

    // Outputs
    {% for var in trans.variables %}
    {% if var.direction == "output" %}
    {{ var.sv_type }} {{ var.name }};
    {% endif %}
    {% endfor %}

    {% if trans.constraints %}
    // Constraints from Config
    {% endif %}
    //TODO:
    {% for const in trans.constraints %}
    constraint {{ const.name }} {
        {% for line in const.body %}
        {{ line }};
        {% endfor %}
    }
    {% endfor %}

    // Generated Constraints
    {% for var in trans.variables %}
    constraint c_{{ var.name }} {

    }
    {% endfor %}

    // UVM Macros
    `uvm_object_utils_begin({{ trans.class_name }})
        {% for var in trans.variables %}
        {{ var.uvm_field_macro }}
        {% endfor %}
    `uvm_object_utils_end

    // Constructor
    function new(string name = "{{ trans.class_name }}");
        super.new(name);
    endfunction

    function void do_copy (uvm_object rhs);
        {{ trans.class_name}} rhs_;

        if( !$cast(rhs_, rhs) ) begin
            `uvm_fatal( "do_copy:", "Failed to cast transaction object." )
            return;
        end

        super.do_copy( rhs );
        {% for var in trans.variables %}
        {{var.name}} = rhs_.{{var.name}};
        {% endfor %}
    endfunction: do_copy

    function bit do_compare(uvm_object rhs, uvm_comparer comparer);
        {{ trans.class_name }} rhs_;
        do_compare = super.do_compare(rhs, comparer);

        if (!$cast(rhs_, rhs))
            `uvm_error("do_compare", "$cast failed for {{ trans.class_name }}.do_compare()")
        if (rhs_ == null)
            `uvm_error("do_compare", "$cast resulted in NULL handle.")

        // Stimulus fields – compared for sequence tracking
        {% for var in trans.rand_variables %}
        do_compare &= comparer.compare_field("{{ var.name }}", {{ var.name }}, rhs_.{{ var.name }}, $bits({{ var.name }}));
        {% endfor %}

        // Response fields – uncomment when used in scoreboard
        {% for var in trans.nonrand_variables %}
        // do_compare &= comparer.compare_field("{{ var.name }}", {{ var.name }}, rhs_.{{ var.name }}, $bits({{ var.name }}));
        {% endfor %}

        return do_compare;
    endfunction : do_compare

    function void do_record(uvm_recorder recorder);
        super.do_record(recorder);
        {% for var in trans.variables %}
        `uvm_record_field("{{ var.name }}", {{ var.name }})
        {% endfor %}
    endfunction : do_record


endclass : {{ trans.class_name }}